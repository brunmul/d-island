<Application x:Class="DIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Theme palette (Services\ThemeService.ApplyPalette changes these colors in place, so they are
             never frozen; styles reference them through DynamicResource so sealing a style can't freeze them).
             The values here are the Classic theme; a chosen theme overrides them at startup. -->
        <SolidColorBrush x:Key="Surface" Color="#FF000000" />
        <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Secondary" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Tertiary" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="Green" Color="#FF30D158" />
        <SolidColorBrush x:Key="Orange" Color="#FFFF9F0A" />
        <SolidColorBrush x:Key="Red" Color="#FFFF453A" />
        <SolidColorBrush x:Key="Cyan" Color="#FF64D2FF" />
        <SolidColorBrush x:Key="Purple" Color="#FFBF5AF2" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="Fill" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="FillHover" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="FillPressed" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="Separator" Color="#22FFFFFF" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource Fill}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Application.Resources>
</Application>
